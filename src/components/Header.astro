---
import { NAV, SITE } from '../config';
import { url } from '../utils/url';
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.replace(base, '') || '/';
const isActive = (href: string) => current === href || current.startsWith(href);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={url('/')} aria-label={`${SITE.name} home`}>
      {SITE.name}<span class="wordmark-dot" aria-hidden="true"></span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {
        NAV.map((item) => (
          <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <ThemeToggle />
  </div>
</header>
