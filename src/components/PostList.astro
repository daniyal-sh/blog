---
import type { Post } from '../lib/posts';
import { formatDate, readingTime } from '../utils/format';
import { url } from '../utils/url';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="project-empty">No posts yet.</p>
  ) : (
    <ol class="post-list">
      {posts.map((post) => (
        <li class="post-row">
          <a class="post-row-link" href={url(`/posts/${post.id}/`)}>
            <time class="post-date" datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
            <div class="post-row-body">
              <h2 class="post-row-title">{post.data.title}</h2>
              <p class="post-row-desc">{post.data.description}</p>
            </div>
            <span class="post-row-time">{readingTime(post.body)} min</span>
          </a>
        </li>
      ))}
    </ol>
  )
}
